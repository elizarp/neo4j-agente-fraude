# Copie este arquivo para .env e preencha com as suas credenciais.
#   cp .env.example .env
#
# O .env está no .gitignore e nunca deve ser comitado.
# Os notebooks carregam essas variáveis automaticamente (via python-dotenv),
# então você configura uma vez e não digita mais nada.

# --- Conexão com o banco (todos os notebooks) ---------------------------
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# ATENÇÃO: em instâncias AuraDB recentes o banco padrão NÃO é "neo4j", e sim o
# próprio instance id (o prefixo da URI acima). No Neo4j Sandbox, use "neo4j".
NEO4J_DATABASE=neo4j

# --- Aura Graph Analytics (só o notebook 04) ---------------------------
# Gere em: Aura Console > perfil/organização > API credentials
# O Client Secret é exibido uma única vez.
AURA_CLIENT_ID=
AURA_CLIENT_SECRET=

# Prefixo da URI de conexão: em neo4j+s://dbd12345.databases.neo4j.io é "dbd12345"
AURA_INSTANCEID=
